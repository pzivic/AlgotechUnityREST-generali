<configuration>
	<configSections>
		<section name="oracle.manageddataaccess.client" type="OracleInternal.Common.ODPMSectionHandler, Oracle.ManagedDataAccess, Version=4.122.21.1, Culture=neutral, PublicKeyToken=89b483f429c47342" />
	</configSections>

	<appSettings>
		<add key="webpages:Version" value="3.0.0.0" />
		<add key="webpages:Enabled" value="false" />
		<add key="ClientValidationEnabled" value="true" />
		<add key="UnobtrusiveJavaScriptEnabled" value="true" />

		<!-- OnBase -->
		<add key="AppServerURL" value="https://sbonbase.algotech.test/AppServer64/service.asmx" />
		<add key="DataSource" value="OnBaseSB" />
		<add key="UserName" value="manager" />
		<add key="UserPassword" value="Password1" />

		<!--
	<add key="LicenceType" value="QueryMetering" />  
	<add key="LicenceType" value="Default" />
	-->
		<add key="LicenceType" value="QueryMetering" />

		<!--
	<add key="UserName" value="service_unityapi_named" />
    <add key="UserPassword" value="aSd3#12gTi" />
	-->

		<!-- OnBase DocPop-->
		<add key="OnBaseDocPop" value="http://sbonbase.algotech.test/AppNet/docpop/docpop.aspx?clienttype=html" />
		<!-- OnBase DocBarcode keyword -->
		<add key="OnBaseDocPopKeyword" value="KT167" />

		<!-- Podrazumevana konekcija za OnBase -->
		<add key="DocumentImportReturnDocumentID" value="False" />
		<add key="DocumentAK_LenghtPrefiks" value="2" />
		<add key="DocumentAK_LenghtBase" value="3" />
		<add key="DocumentAK_LenghtSufix" value="9" />
		<add key="DocumentAK_Separator" value="" />

		<add key="UploadFolder" value="D:\Temp\OnBase\Upload" />
		<add key="ExportFolder" value="D:\Temp\OnBase\Export" />
		<add key="ForceLockDocument" value="False" />
		<add key="ForceLockDocumentOnDelete" value="False" />

		<add key="MAX_DOCUMENTS_TO_RETURN" value="1000" />
		<add key="MAX_DOCUMENTS_TO_RETURN_WF" value="1000" />

		<!--Podrazumevana vrednost za Application.Timeout u OnBase C# API-ju je 60 sekundi (ili 60000 milisekundi).-->
		<!--<add key="APPLICATION_TIMEOUT" value="120000" />-->
		<add key="APPLICATION_TIMEOUT" value="0" />

		<!-- Osnovna disk grupa [Bankarska dokumentacija] ili [Algotech_DMS] OnBase ima disk grupe ne znamo u kojoj je disk grupi dokument-->
		<add key="DiskGroupID" value="102" />
		<add key="AlgotechUnityRESTUrl" value="http://localhost/AlgotechUnityREST-ckb" />

		<!--<add key="DateFormat" value="Local" />-->
		<add key="DateFormat" value="IsoDateFormat" />
		<add key="IsAppPoolConnection" value="True" />
		<add key="IsEnvPROD" value="True" />

		<!--Autorizacija -->
		<add key="OAuthIssuer" value="http://localhost/AlgotechUnityREST-ckb" />
		<add key="OAuthAudience" value="AlgotechUnityREST" />
		<add key="OAuthSigningKey" value="Yi4Av3dXG8UWSsyePAKJCNHupDHxcnulQ20UujRhjnQ=" />
		<add key="OAuthAccessTokenExpire" value="30" />
		
		<add key="OAuthClientId" value="ALGOTECH_REST_CLIENT_ID" />
		<add key="OAuthClientSecret" value="ALGOTECH_REST_SECRET" />
	</appSettings>

	<!--Konekcioni string -->
	<connectionStrings>
		<!-- za afks ali treba nam u app tabela ako idemo na app.conection onbase-->
		<add name="connection_string_onbase" connectionString="server=dvsdevteam_dr.algotech.test;database=OnBaseSBep6Unicode;uid=viewer;pwd=cprt_hsi;Application Name=AlgotechUnityREST-ckb" />
		<add name="connection_string_oracle" connectionString="Data Source=(DESCRIPTION=(ADDRESS_LIST=(ADDRESS=(PROTOCOL=TCP)(HOST=)(PORT=))) (CONNECT_DATA=(SERVER=DEDICATED)(SERVICE_NAME=)));User Id=ONBASEINTERFACE;Password=SEP#2022;Min Pool Size=10;Connection Lifetime=120;Connection Timeout=60;Incr Pool Size=5;Decr Pool Size=2;" />
		<add name="connection_string_mssql" connectionString="server=dvsdevteam.algotech.test;database=OnBaseUTL;uid=onbase_utl_login;pwd=npR#23aq;Application Name=OnBaseUnityScript" />
		<!--<add name="connection_string_mssql" connectionString="server=dvsdevteam.algotech.test;database=GeneratedData;uid=viewer;pwd=cprt_hsi;Application Name=AlgotechUnityREST-ckb" />-->
		<!--<add name="connection_string_mssql" connectionString="Data Source=nostromo2.algotech.co.yu;Integrated Security=True;Encrypt=False;database=ALGOTECH;" />-->
	</connectionStrings>

	<system.web>
		<compilation debug="true" targetFramework="4.8" />
		<httpRuntime targetFramework="4.8" maxRequestLength="209715200" />

		<!-- Globalizacija -->
		<globalization culture="sr-Latn-ME" uiCulture="sr-Latn-ME" />
		<!--<globalization culture="sr-Latn-RS" uiCulture="sr-Latn-RS" />-->
		<!--<globalization culture="de-DE" uiCulture="de-DE" />-->
	</system.web>

	<system.webServer>
		<validation validateIntegratedModeConfiguration="false" />
		<handlers>
			<remove name="ExtensionlessUrlHandler-Integrated-4.0" />
			<remove name="OPTIONSVerbHandler" />
			<remove name="TRACEVerbHandler" />
			<add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
		</handlers>
		<security>
			<requestFiltering>
				<requestLimits maxAllowedContentLength="40000000" />
			</requestFiltering>
		</security>
	</system.webServer>
